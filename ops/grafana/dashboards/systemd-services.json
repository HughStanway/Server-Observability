{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Service States",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "center",
            "cellOptions": { "type": "color-text" },
            "filterable": true,
            "inspect": false
          },
          "mappings": [
            {
              "options": {
                "0": { "color": "text", "index": 0, "text": "" },
                "1": { "color": "green", "index": 1, "text": "●" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "name" },
            "properties": [
              { "id": "custom.width", "value": 320 },
              { "id": "custom.align", "value": "left" },
              { "id": "custom.cellOptions", "value": { "type": "auto" } },
              { "id": "mappings", "value": [] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #active" },
            "properties": [
              { "id": "displayName", "value": "Active" },
              { "id": "custom.width", "value": 90 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #failed" },
            "properties": [
              { "id": "displayName", "value": "Failed" },
              { "id": "custom.width", "value": 90 },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": { "color": "text", "index": 0, "text": "" },
                      "1": { "color": "red", "index": 1, "text": "●" }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "text", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #inactive" },
            "properties": [
              { "id": "displayName", "value": "Inactive" },
              { "id": "custom.width", "value": 90 },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": { "color": "text", "index": 0, "text": "" },
                      "1": { "color": "yellow", "index": 1, "text": "●" }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "text", "value": null },
                    { "color": "yellow", "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          { "desc": false, "displayName": "name" }
        ]
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "systemd_unit_state{state=\"active\", name=~\".+\\\\.service\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "refId": "active"
        },
        {
          "editorMode": "code",
          "expr": "systemd_unit_state{state=\"failed\", name=~\".+\\\\.service\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "refId": "failed"
        },
        {
          "editorMode": "code",
          "expr": "systemd_unit_state{state=\"inactive\", name=~\".+\\\\.service\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "refId": "inactive"
        }
      ],
      "title": "All Systemd Services",
      "description": "Current state of all systemd service units on the host.",
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": {
            "byField": "name"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "state 1": true,
              "state 2": true,
              "state 3": true
            },
            "indexByName": {},
            "renameByName": {
              "name": "name"
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "Value #active",
                "config": {
                  "id": "equal",
                  "options": { "value": "1" }
                }
              }
            ],
            "match": "any",
            "type": "include"
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "Failed Units",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": { "color": "green", "index": 0, "text": "None" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 14 },
      "id": 10,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(systemd_unit_state{state=\"failed\", name=~\".+\\\\.service\"} == 1) or vector(0)",
          "legendFormat": "Failed",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Total Failed Units",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "left",
            "cellOptions": { "type": "auto" },
            "filterable": false,
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 14 },
      "id": 11,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "systemd_unit_state{state=\"failed\", name=~\".+\\\\.service\"} == 1",
          "legendFormat": "{{name}}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Failed Unit Names",
      "description": "List of systemd service units currently in the failed state.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "state": true
            },
            "renameByName": {
              "name": "Service Unit"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 102,
      "title": "Resource Accounting",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": { "mode": "none", "group": "A" }
          },
          "mappings": [],
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 20,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "topk(10, rate(systemd_unit_cpu_seconds_total{name=~\".+\\\\.service\"}[5m]) * 100)",
          "legendFormat": "{{name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "CPU Usage by Service (Top 10)",
      "description": "CPU utilization percentage for the top 10 most CPU-intensive systemd services.",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 21,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "topk(10, systemd_unit_tasks_current{name=~\".+\\\\.service\"})",
          "legendFormat": "{{name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Task Count by Service (Top 10)",
      "description": "Number of tasks (threads) for the top 10 services with most tasks.",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "id": 103,
      "title": "Service Restarts",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 29 },
      "id": 30,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["sum"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "topk(10, increase(systemd_service_restart_total{name=~\".+\\\\.service\"}[1h]))",
          "legendFormat": "{{name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Service Restarts (Last Hour)",
      "description": "Services that have restarted within the last hour. Frequent restarts may indicate crash loops.",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "id": 104,
      "title": "System Journal",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 38 },
      "id": 40,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["sum"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (unit) (count_over_time({job=\"systemd-journal\"} |= \"error\" or {job=\"systemd-journal\"} |= \"ERROR\" or {job=\"systemd-journal\"} |= \"failed\" [5m]))",
          "legendFormat": "{{unit}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Error Log Events by Unit",
      "description": "Distribution of error-level log events across systemd units.",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 44 },
      "id": 41,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "{job=\"systemd-journal\"} |= \"error\" or {job=\"systemd-journal\"} |= \"ERROR\" or {job=\"systemd-journal\"} |= \"failed\" or {job=\"systemd-journal\"} |= \"FAILED\"",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "System Error Logs",
      "description": "Live stream of error and failure messages from the systemd journal.",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 40,
  "tags": [
    "server",
    "observability",
    "systemd",
    "loki"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "title": "Systemd Services",
  "uid": "systemd-services",
  "version": 1,
  "weekStart": ""
}
